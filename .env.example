# Firebase Authentication
FIREBASE_PROJECT_ID=pohapp-8f1ab
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# IA — modo de contexto del asistente: catalog (actual) | rag (retrieval top-k)
ANTHROPIC_API_KEY=replace-with-anthropic-key
AI_CONTEXT_MODE=catalog
AI_SIMILARITY_MIN=0.35

# Moderación de contenido antes de activar registros en el catálogo.
# Los registros PE no se envían a la IA; la transición a AC sí requiere este gate.
AI_MODERATION_ENABLED=true
AI_MODERATION_MODEL=claude-haiku-4-5-20251001
AI_MODERATION_MIN_CONFIDENCE=0.75
